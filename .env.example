# Required. There is no localhost fallback: the app, scripts and alembic fail if unset.
# Driver prefix must be postgresql+psycopg:// (Supabase's copy button gives plain postgresql://).

# --- Local Docker (docker-compose.yml) ---
DATABASE_URL=postgresql+psycopg://easy_a:easy_a@localhost:5432/easy_a

# --- Hosted Supabase (replace placeholders; never commit real values) ---
# App: transaction pooler (Supavisor, port 6543). Prepared statements are disabled automatically.
# DATABASE_URL=postgresql+psycopg://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?sslmode=require
# Alembic only: session pooler (same host, port 5432; works over IPv4). Falls back to DATABASE_URL if unset.
# The direct host db.<PROJECT_REF>.supabase.co:5432 is IPv6-only without Supabase's IPv4 add-on.
# MIGRATION_DATABASE_URL=postgresql+psycopg://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require

EASY_A_ECHO_SQL=false
